# Copy to .env for LOCAL development (Docker Compose or uvicorn). Never commit .env.
# Placeholders only. Comments must be on their own lines (Docker's env_file does not strip inline comments).

# --- Environment ---
# "development" locally; "production" on a host (turns on strict startup checks and HTTPS-only personal keys)
ENVIRONMENT=development

# --- Shared demo Gemini key (backend only; never put it in the frontend or a VITE_ variable) ---
# Leave blank to run with no shared AI: visitors then connect their own key. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Check Google's current model list before launch: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Accounts. Leave JWT_SECRET blank locally (one is generated into the data folder). REQUIRED in production:
# python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
ALLOW_REGISTRATION=true

# --- Demo limits (apply to the shared key; personal keys are not counted) ---
UPLOAD_MAX_MB=10
MAX_DOCS_PER_USER=20
MAX_CHUNKS_PER_DOC=3000
DAILY_LLM_CALLS_PER_USER=30
DAILY_LLM_CALLS_GLOBAL=300
DEMO_MAX_QUESTION_CHARS=600
PERSONAL_MAX_QUESTION_CHARS=2000
RATE_AUTH_PER_MIN=10
RATE_LLM_PER_MIN=15
RATE_UPLOAD_PER_MIN=10
RATE_GENERAL_PER_MIN=120
QUOTA_COOLDOWN_MINUTES=30

# --- Retrieval / learning rules ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
MIN_RELEVANCE=0.30
MIN_ATTEMPTS_PER_TOPIC=5
WEAK_THRESHOLD=0.6

# --- Paths / networking ---
SQLITE_PATH=./data/learnmate.db
CHROMA_PERSIST_DIRECTORY=./data/chroma
# Exact frontend origin(s), comma separated, no trailing slash. In production these must be https://
CORS_ORIGINS=http://localhost:5173
# Only behind a trusted reverse proxy (Render, Caddy). Then set the number of proxies in front of the app.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_HOPS=1
# Show the "demo hosting may wipe data" notice in the UI (true on hosts with ephemeral disks)
EPHEMERAL_STORAGE_NOTICE=false

# --- docker-compose.prod.yml only ---
DOMAIN=learnmate.example.com
