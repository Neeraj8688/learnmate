# Frontend build-time setting. Public backend URL only. NEVER put API keys or secrets in a VITE_ variable:
# everything prefixed VITE_ is copied into the public JavaScript bundle.
# Local dev: leave unset (defaults to http://localhost:8000) or set it explicitly:
# VITE_API_BASE_URL=http://localhost:8000
# Vercel: set to your Render backend URL, e.g.
VITE_API_BASE_URL=https://your-backend.onrender.com
